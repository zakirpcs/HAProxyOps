# Copy to .env for local development. Production reads these from files in
# /run/secrets instead - see deploy/docker/.

# Encrypts stored node credentials. Losing it means re-entering every node password.
HAPROXYOPS_SECRET_KEY=generate-with-openssl-rand-hex-32

HAPROXYOPS_DATABASE_URL=sqlite+aiosqlite:///./haproxyops.db
HAPROXYOPS_REDIS_URL=redis://localhost:6379/0

# Allow the Vite dev server to call the API. Set to [] in production,
# where nginx serves the SPA from the same origin.
HAPROXYOPS_CORS_ORIGINS=["http://localhost:5173"]

HAPROXYOPS_POLL_INTERVAL_SECONDS=10
HAPROXYOPS_POLL_TIMEOUT_SECONDS=5
HAPROXYOPS_POLL_CONCURRENCY=32

HAPROXYOPS_INITIAL_ADMIN_USERNAME=admin
HAPROXYOPS_INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# Alerting. Leave blank to disable it entirely - nothing is evaluated and no
# state is kept until a webhook is set.
HAPROXYOPS_ALERT_WEBHOOK_URL=
HAPROXYOPS_ALERT_FOR_SECONDS=60
HAPROXYOPS_ALERT_REPEAT_SECONDS=3600
